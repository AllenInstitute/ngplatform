{
  // Neuroglancer's sources are typechecked with the app, so these follow the
  // fork's own options (it does not use `strict`'s function-type checks).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["dom", "webworker", "esnext", "dom.iterable"],
    "types": ["vite/client"],
    "paths": {
      "@ngplatform/sdk": ["./src/sdk/index.ts"],
      "@ngplatform/sdk/*": ["./src/sdk/*.ts"]
    }
  },
  // Each plugin's top-level files and tests; zarr-vectors' package is
  // checked with its own options (npm run typecheck).
  "include": ["src", "tests", "plugins/*.ts", "plugins/*/*.ts", "plugins/*/tests"],
  "exclude": ["plugins/*/vitest.config.ts"]
}
