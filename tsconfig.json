{
  // Neuroglancer's sources are typechecked with the app, so these follow the
  // fork's own options (it does not use `strict`'s function-type checks).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // chunkmirage's engine (vendor/chunkmirage) imports some modules by their .ts names.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["dom", "webworker", "esnext", "dom.iterable"],
    "types": ["vite/client"],
    "paths": {
      "@ngplatform/sdk": ["./src/sdk/index.ts"],
      "@ngplatform/sdk/*": ["./src/sdk/*.ts"],
      "chunkmirage-web/*": ["./vendor/chunkmirage/web/src/*"],
      "neuroglancer-zarr-vectors": ["./plugins/zarr-vectors/src/register_default.ts"],
      "neuroglancer-zarr-vectors/backend": ["./plugins/zarr-vectors/src/backend.ts"],
      "neuroglancer-zarr-vectors/async_computation": ["./plugins/zarr-vectors/src/async_computation.ts"],
      "neuroglancer-zarr-vectors/reader": ["./plugins/zarr-vectors/src/reader.ts"],
      "neuroglancer-zarr-vectors/source-url": ["./plugins/zarr-vectors/src/source_url.ts"]
    }
  },
  // Each plugin's top-level files and tests; zarr-vectors' package is
  // checked with its own options (npm run typecheck).
  "include": ["src", "tests", "plugins/*.ts", "plugins/*/*.ts", "plugins/*/tests"],
  "exclude": ["plugins/*/vitest.config.ts"]
}
