{
  "name": "neuroglancer-zarr-vectors",
  "version": "0.2.0",
  "description": "Zarr Vectors stores in Neuroglancer, as a plugin: a data source and layer drawing for point clouds, lines, streamlines, skeletons, graphs and meshes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/register_default.ts",
    "./backend": "./src/backend.ts",
