diff --git a/benchmarks/filtering/README.md b/benchmarks/filtering/README.md
new file mode 100644
index 0000000..e137eb6
--- /dev/null
+++ b/benchmarks/filtering/README.md
@@ -0,0 +1,85 @@
+# Filtering: gate G1
+
+*Is numpy, run inside the browser by Pyodide, fast enough to be the
+streamline filter engine of a Neuroglancer-based viewer?*
+
+This is gate G1 of the viewer platform's build guide. The filter plan sets
+interactive targets (its C8): an operator flip under 16 ms, a column filter
+under 50 ms, a 5 mm sphere under 100 ms, publishing the answer to the GPU
+under 20 ms, peak memory under 1.5 GB, and a first answer within 3 s. If
+numpy meets them under Pyodide, the platform needs no Rust kernel for those
+steps.
+
+## What is measured
+
+`g1.py` builds an `IndexedEngine` (`zarr_vectors_tools.filtering`) over a
+tractogram held in memory, then asks it every kind of question. Each region
+query gets a fresh region centred on a random vertex, so nothing comes from
+the cache; P3 flips the operators of trees whose leaves are all cached. The
+brute-force oracle answers one sphere too, as a cross-check (the run records
+whether they agree) and as the baseline the index must beat.
+
+| Key | Question |
+|---|---|
+| `build_s` | building the segment index (the engine's start-up) |
+| `sphere_ms`, `box_ms`, `disk_ms`, `mask_ms` | one region of about 5 mm (box 10 mm, mask 10 x 1 mm voxels) |
+| `slab_ms` | a 2 mm slab, TrackVis's slice filter |
+| `endpoints_ms` | a 5 mm sphere, either end inside |
+| `p1_ms` | `length between (p10, p90)` |
+| `p3_ms` | re-evaluating a four-leaf tree, every leaf cached |
+| `publish_ms` | three answers to one byte per streamline |
+| `oracle_sphere_s` | the same sphere, every segment tested |
+| `loaded_mb`, `peak_mb` | memory with the set loaded, and at its peak |
+
+Times are compute only: the geometry is already in memory, so nothing is
+fetched or decoded. `peak_mb` is the process's peak RSS under CPython, and
+the wasm heap under Pyodide, which only grows. Both include loading the set
+from `data/`, where `run.py` wrote it beforehand in a separate process, so
+generating a synthetic set costs neither runtime anything.
+
+The sets:
+
+- `synth-1e5`, `synth-1e6`: `whole_brain_like(n, seed=0)`. Streamlines with
+  1 mm steps and lengths of 20–200 mm (median about 50), curving smoothly
+  and folded back into a brain-sized ellipsoid. That gives a whole brain's
+  density, about 40 vertices per mm³ at 10^6 streamlines.
+- `real`: a store passed as `--real`, cached as `data/real/`. The
+  results below used the HiP-CT right-hemisphere iFOD2 tractogram
+  (`hip_ct_zarr_vector_.../APEX_hackathon/sub-Ha1_sample-RightHemi_...`):
+  79,648 streamlines and 39.4 M vertices at a 0.1 mm step.
+
+## Running
+
+You need an unpacked Pyodide distribution holding `pyodide.mjs`,
+`pyodide-lock.json` and the numpy wheel. The release tarball has them all,
+and nothing is fetched from a CDN.
+
+```bash
+curl -LO https://github.com/pyodide/pyodide/releases/download/314.0.7/pyodide-314.0.7.tar.bz2
+tar -xjf pyodide-314.0.7.tar.bz2      # -> ./pyodide/
+python benchmarks/filtering/run.py --pyodide-dir ./pyodide [--real path/to/store.zarrvectors]
+```
+
+Each set runs in a fresh process per runtime. Results go to
+`results/measurements.json` and `results/summary.md`. Run one runtime or set
+with `--runtimes cpython` or `--sets synth-1e5`. Under Pyodide the filtering
+subpackage is copied in as the package `zvfilter`, since it imports only
+numpy and itself; that is how a browser worker would load it.
+
+## Results
+
+See [`results/summary.md`](results/summary.md) for the table and
+[`results/measurements.json`](results/measurements.json) for every number
+(including p90 and max). They were measured on a 4-core cloud container with
+Python 3.13 / numpy 2.5 and Pyodide 314.0.7 (Python 3.14, numpy 2.4) under
+Node 22.
+
+RESULTS_PLACEHOLDER
+
+## Caveats
+
+- One machine, one run; the times are for comparing runtimes and sets, not
+  absolute.
+- Single-threaded throughout, as Pyodide is.
+- The engine holds level 0 whole in memory. A browser engine streams
+  chunks, so it fetches and decodes as well; that cost is not measured here.
diff --git a/benchmarks/filtering/g1.py b/benchmarks/filtering/g1.py
new file mode 100644
index 0000000..bac37b5
--- /dev/null
+++ b/benchmarks/filtering/g1.py
@@ -0,0 +1,186 @@
+"""Gate G1: is numpy fast enough to be the in-browser filter engine?
+
+The build guide's gate G1 asks whether numpy under Pyodide meets the filter
+plan's interactive targets (C8) on 10^5 and 10^6 streamline tractograms; if
+it does, the Rust kernel is needed only for the spatial work.  This module
+is the measurement.  It imports nothing but numpy and the filtering
+subpackage, which the caller passes in, so the very same code runs under
+CPython and inside Pyodide (see run.py and pyodide_worker.mjs).
+
+Each set is filtered by the indexed engine with level 0 already in memory,
+so the times are compute only: no fetching, no decoding.  The brute-force
+oracle answers one of the same questions as a cross-check, and as the
+baseline the index has to beat.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import numpy as np
+
+#: The filter plan's C8 targets, in the units each measurement reports.
+GATES = {
+    "p3_ms": 16.0,          # operator flip, every leaf cached
+    "p1_ms": 50.0,          # one column comparison
+    "sphere_ms": 100.0,     # sphere r = 5 mm, geometry in memory
+    "publish_ms": 20.0,     # answers -> one byte per streamline
+    "peak_mb": 1536.0,      # peak memory while filtering
+    "first_result_s": 3.0,  # index build + first sphere
+}
+
+#: Synthetic sets: name -> streamline count.  Whole-brain-like, 1 mm steps.
+SYNTHETIC = {"synth-1e5": 100_000, "synth-1e6": 1_000_000}
+
+
+def prepare_set(filtering, name: str, data_dir: str | Path, store: str | None = None) -> None:
+    """Write set ``name`` to ``data_dir/name/`` as .npy files.
+
+    A synthetic set is generated; ``real`` is read from ``store`` (positions
+    kept as float32 RAS).  Both runtimes then load the same arrays, and
+    neither pays for generating them: a wasm heap never shrinks, so
+    generating inside Pyodide would count the generator's temporaries
+    against the engine.
+    """
+    if name in SYNTHETIC:
+        tg = filtering.whole_brain_like(SYNTHETIC[name], seed=0)
+        columns = {k: tg.columns[k] for k in ("fa_mean", "label")}
+    elif name == "real":
+        tg = filtering.load_tractogram(store, columns=["label_id"])
+        columns = {k: v for k, v in tg.columns.items() if k == "label_id"}
+    else:
+        raise ValueError(f"unknown set {name!r}")
+    out = Path(data_dir) / name
+    (out / "columns").mkdir(parents=True, exist_ok=True)
+    np.save(out / "vertices.npy", tg.vertices.astype(np.float32))
+    np.save(out / "offsets.npy", tg.offsets)
+    for key, values in columns.items():
+        np.save(out / "columns" / f"{key}.npy", values)
+
+
+def make_set(filtering, name: str, data_dir: str | Path):
+    """Load the set :func:`prepare_set` wrote (``length`` is computed on load)."""
+    where = Path(data_dir) / name
+    columns = {p.stem: np.load(p) for p in sorted((where / "columns").glob("*.npy"))}
+    return filtering.Tractogram(
+        np.load(where / "vertices.npy"), np.load(where / "offsets.npy"), columns=columns,
+    )
+
+
+def _timed(fn):
+    start = time.perf_counter()
+    out = fn()
+    return (time.perf_counter() - start) * 1e3, out
+
+
+def _stats(values: list[float]) -> dict[str, float]:
+    arr = np.asarray(values)
+    return {"median": float(np.median(arr)), "p90": float(np.percentile(arr, 90)),
+            "max": float(arr.max())}
+
+
+def measure(filtering, tractogram, *, trials: int = 9, seed: int = 0, memory_mb=None) -> dict:
+    """Time every kind of question on one tractogram.
+
+    Each region query uses a fresh region (centred on a random vertex), so
+    its leaf is never cached; P3 re-evaluates trees whose leaves all are.
+    ``memory_mb``, if given, reports the process's memory now; it is
+    sampled once the set is loaded and again once the index is built.
+    """
+    F = filtering
+    tg = tractogram
+    engine = None
+    out: dict = {
+        "n_streamlines": int(tg.n_objects),
+        "n_vertices": int(len(tg.vertices)),
+        "tractogram_mb": round((tg.vertices.nbytes + tg.offsets.nbytes) / 1e6, 1),
+    }
+    if memory_mb is not None:
+        out["loaded_mb"] = round(memory_mb())
+    build_ms, engine = _timed(lambda: F.IndexedEngine(tg))
+    out["build_s"] = build_ms / 1e3
+    out["index_mb"] = round(engine.index_bytes / 1e6, 1)
+    if memory_mb is not None:
+        out["built_mb"] = round(memory_mb())
+    out["cell_size_mm"] = round(engine.cell_size, 3)
+
+    rng = np.random.default_rng(seed)
+    centres = tg.vertices[rng.integers(0, len(tg.vertices), trials)].astype(np.float64)
+
+    def regions(make, label: str) -> None:
+        times, counts, work = [], [], []
+        for centre in centres:
+            ms, result = _timed(lambda c=centre: engine.evaluate(make(c)))
+            times.append(ms)
+            counts.append(int(result.sum()))
+            work.append(dict(engine.last_query))
+        out[f"{label}_ms"] = _stats(times)
+        out[f"{label}_accepted"] = int(np.median(counts))
+        if work[0]:
+            # Segments filed near the region, and how many needed the exact test.
+            out[f"{label}_candidates"] = int(np.median([w["candidates"] for w in work]))
+            out[f"{label}_tested"] = int(np.median([w["tested"] for w in work]))
+            # Segments tested per second: the rate a faster kernel would improve.
+            tested = np.array([w["tested"] for w in work], dtype=float)
+            out[f"{label}_tested_per_s"] = float(np.median(tested / (np.asarray(times) / 1e3)))
+
+    regions(lambda c: F.Passes(F.Sphere(c, 5.0)), "sphere")
+    out["first_result_s"] = out["build_s"] + out["sphere_ms"]["max"] / 1e3
+    regions(lambda c: F.Passes(F.Box(c - 5.0, c + 5.0)), "box")
+    regions(lambda c: F.Passes(F.Slab(1, c[1] - 1.0, c[1] + 1.0)), "slab")
+    normals = rng.normal(size=(trials, 3))
+    normal_of = {tuple(c): n for c, n in zip(centres, normals)}
+    regions(lambda c: F.Passes(F.Disk(c, normal_of[tuple(c)], 5.0)), "disk")
+    blob = rng.random((10, 10, 10)) < 0.5
+
+    def mask_at(c):
+        affine = np.eye(4)
+        affine[:3, 3] = c - 4.5           # 10 x 1 mm voxels centred on c
+        return F.Passes(F.Mask(blob, affine))
+
+    regions(mask_at, "mask")
+    regions(lambda c: F.Passes(F.Sphere(c + 0.25, 5.0), "endpoints"), "endpoints")
+
+    lengths = tg.columns["length"]
+    lo_hi = np.percentile(lengths, [10, 90])
+    p1 = []
+    for k in range(trials):
+        leaf = F.Column("length", "between", (float(lo_hi[0]) + 0.01 * k, float(lo_hi[1])))
+        p1.append(_timed(lambda leaf=leaf: engine.evaluate(leaf))[0])
+    out["p1_ms"] = _stats(p1)
+
+    # P3: four cached leaves, the operators flipped between evaluations.
+    a = F.Passes(F.Sphere(centres[0], 5.0))
+    b = F.Passes(F.Box(centres[1] - 5.0, centres[1] + 5.0))
+    c = F.Column("length", ">", float(np.median(lengths)))
+    d = F.Passes(F.Slab(1, centres[2][1] - 1.0, centres[2][1] + 1.0))
+    trees = [F.And(a, b, F.Not(c), d), F.Or(a, b, c, d), F.And(F.Or(a, b), F.Not(d), c),
+             F.Or(F.And(a, c), F.Not(b), d)]
+    for tree in trees:
+        engine.evaluate(tree)  # fill the cache
+    p3 = [_timed(lambda t=trees[k % len(trees)]: engine.evaluate(t))[0] for k in range(4 * trials)]
+    out["p3_ms"] = _stats(p3)
+
+    groups = [engine.evaluate(t) for t in trees[:3]]
+    out["publish_ms"] = _stats([_timed(lambda: engine.publish(groups))[0] for _ in range(trials)])
+
+    # The oracle answers the first sphere again, testing every segment.
+    leaf = F.Passes(F.Sphere(centres[0], 5.0))
+    oracle_ms, truth = _timed(lambda: F.evaluate(leaf, tg))
+    out["oracle_sphere_s"] = oracle_ms / 1e3
+    out["agrees_with_oracle"] = bool(np.array_equal(truth, engine.evaluate(leaf)))
+    return out
+
+
+def verdict(result: dict) -> dict[str, bool]:
+    """Which C8 gates one set's result meets."""
+    seen = {
+        "p3_ms": result["p3_ms"]["median"],
+        "p1_ms": result["p1_ms"]["median"],
+        "sphere_ms": result["sphere_ms"]["median"],
+        "publish_ms": result["publish_ms"]["median"],
+        "peak_mb": result.get("peak_mb", float("nan")),
+        "first_result_s": result["first_result_s"],
+    }
+    return {gate: bool(seen[gate] <= limit) for gate, limit in GATES.items()}
diff --git a/benchmarks/filtering/pyodide_worker.mjs b/benchmarks/filtering/pyodide_worker.mjs
new file mode 100644
index 0000000..cd4f659
--- /dev/null
+++ b/benchmarks/filtering/pyodide_worker.mjs
@@ -0,0 +1,61 @@
+// Run g1.measure() for one set inside Pyodide, under Node, and print its JSON.
+//
+//   node pyodide_worker.mjs <pyodide-dir> <set> [data-dir]
+//
+// <pyodide-dir> is an unpacked Pyodide distribution holding pyodide.mjs,
+// pyodide-lock.json and the numpy wheel (the release tarball has them all);
+// nothing is fetched from a CDN.  The filtering subpackage is copied into
+// Pyodide's file system as the top-level package `zvfilter` -- it imports
+// only numpy and itself -- and g1.py next to it, so the code measured is the
+// code in this checkout.  run.py drives this once per set, in a fresh
+// process, so each set's peak wasm memory is its own.
+
+import { readdirSync, readFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const [pyodideDir, setName, dataDir] = process.argv.slice(2);
+if (!pyodideDir || !setName) {
+  console.error("usage: node pyodide_worker.mjs <pyodide-dir> <set> [data-dir]");
+  process.exit(2);
+}
+const here = dirname(fileURLToPath(import.meta.url));
+const packageDir = resolve(here, "../../zarr_vectors_tools/filtering");
+
+const { loadPyodide } = await import(pathToFileURL(join(resolve(pyodideDir), "pyodide.mjs")).href);
+const pyodide = await loadPyodide({ indexURL: resolve(pyodideDir) + "/" });
+await pyodide.loadPackage("numpy", { messageCallback: () => {} });
+
+const fs = pyodide.FS;
+fs.mkdirTree("/bench/zvfilter");
+for (const name of readdirSync(packageDir).filter((n) => n.endsWith(".py"))) {
+  fs.writeFile(`/bench/zvfilter/${name}`, readFileSync(join(packageDir, name)));
+}
+fs.writeFile("/bench/g1.py", readFileSync(join(here, "g1.py")));
+if (dataDir) {
+  fs.mkdirTree("/data");
+  pyodide.mountNodeFS("/data", resolve(dataDir));
+}
+
+const heapMb = () => pyodide._module.HEAPU8.buffer.byteLength / 1e6;
+const startMb = heapMb();
+const json = await pyodide.runPythonAsync(`
+import json, platform, sys
+sys.path.insert(0, "/bench")
+import numpy as np
+import g1, pyodide_js, zvfilter
+
+def heap_mb():
+    return pyodide_js._module.HEAPU8.buffer.byteLength / 1e6
+
+tg = g1.make_set(zvfilter, ${JSON.stringify(setName)}, "/data")
+result = g1.measure(zvfilter, tg, memory_mb=heap_mb)
+result["runtime"] = {"name": "pyodide", "python": platform.python_version(),
+                     "numpy": np.__version__, "pyodide": ${JSON.stringify(pyodide.version)}}
+json.dumps(result)
+`);
+const result = JSON.parse(json);
+// Wasm memory only grows, so its size at the end is the peak.
+result.peak_mb = Math.round(heapMb());
+result.startup_mb = Math.round(startMb);
+console.log(JSON.stringify(result));
