--- /dev/null
+++ b/zarr_vectors_tools/filtering/indexed.py
@@ -0,0 +1,321 @@
+"""An interactive filter engine in numpy: a spatial index plus cached leaves.
+
+This is the design the platform plan proposes for the browser
+(``zarr_vectors_filtering_wasm_plan.md``, part B), built from numpy alone so
+that it runs unchanged under Pyodide and can be timed there (gate G1 of the
+build guide).  It answers exactly what the oracle answers -- the tests hold
+it to that -- but does far less work per question:
+
+- A region leaf tests only the segments filed under the grid cells the
+  region's bounding box touches.  Each segment is filed under every cell its
+  own bounding box overlaps, so a segment that crosses a cell face, or skips
+  over a whole cell, is still found from any cell it passes through.  (A
+  rare long segment spanning many cells goes on a short list tested every
+  time instead.)
+- A segment that lies in one cell, where that cell lies wholly inside the
+  region, meets the region without being tested; and a segment is not
+  tested once its streamline has been accepted.
+- Endpoint modes test only the two ends of each streamline.
+- Every leaf's answer is cached by the leaf's content, so changing an
+  operator, or toggling one leaf, re-runs only the boolean algebra.
+
+Unlike the browser design, it holds level 0 whole in memory: the question it
+answers is how fast numpy computes the filters, not how they are fetched.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from collections.abc import Sequence
+
+import numpy as np
+import numpy.typing as npt
+
+from . import oracle
+from .geometry import contains, region_bounds, segment_hits
+from .predicates import All, And, Box, Column, InGroup, Node, Not, Or, Passes, Slab, Sphere
+from .tractogram import Tractogram
+
+__all__ = ["IndexedEngine"]
+
+#: Segments filed per batch while building the index.
+_BUILD_BLOCK = 1 << 21
+#: Candidate segments tested per batch in a query.
+_QUERY_BLOCK = 1 << 17
+
+
+class IndexedEngine:
+    """Filter one tractogram, interactively.
+
+    Args:
+        tractogram: The streamlines; held, not copied.
+        cell_size: Edge of the index's cubic cells, in millimetres.  The
+            default aims for about ``segments_per_cell`` segments per cell
+            and never goes below twice the median segment length.
+        segments_per_cell: Target occupancy for the default cell size.
+        cache_size: Leaf answers kept (least recently used are dropped).
+        long_cells: A segment whose bounding box spans more cells than this
+            is not filed under each of them but kept on a short list that
+            every region query tests.
+    """
+
+    def __init__(
+        self,
+        tractogram: Tractogram,
+        *,
+        cell_size: float | None = None,
+        segments_per_cell: int = 64,
+        cache_size: int = 256,
+        long_cells: int = 64,
+    ) -> None:
+        self.tractogram = tractogram
+        self._cache: OrderedDict[str, npt.NDArray[np.bool_]] = OrderedDict()
+        self._cache_size = int(cache_size)
+        self._start, self._end, self._owner = tractogram.edges()
+        self._first, self._last, self._has = tractogram.endpoints()
+        #: Counts from the last region query: cells visited, cells wholly
+        #: inside the region, segments accepted untested, candidates, tested.
+        self.last_query: dict[str, int] = {}
+        self._build(cell_size, segments_per_cell, long_cells)
+
+    # -- index -----------------------------------------------------------------
+
+    def _build(self, cell_size: float | None, per_cell: int, long_cells: int) -> None:
+        vertices = self.tractogram.vertices
+        n_edges = len(self._start)
+        self._long = np.zeros(0, dtype=self._start.dtype)
+        if n_edges == 0:
+            self.origin = np.zeros(3)
+            self.cell_size = 1.0
+            self.grid = np.ones(3, dtype=np.int64)
+            self._cell_start = np.zeros(2, dtype=np.int64)
+            self._filed = np.zeros(0, dtype=self._start.dtype)
+            self._single = np.zeros(0, dtype=bool)
+            return
+        lo = vertices.min(axis=0).astype(np.float64)
+        hi = vertices.max(axis=0).astype(np.float64)
+        extent = np.maximum(hi - lo, 1e-9)
+        if cell_size is None:
+            sample = np.arange(0, n_edges, max(1, n_edges // 100_000))
+            steps = np.linalg.norm(
+                vertices[self._end[sample]].astype(np.float64) - vertices[self._start[sample]],
+                axis=1,
+            )
+            volume_cell = float(np.prod(extent)) * per_cell / n_edges
+            cell_size = max(volume_cell ** (1 / 3), 2.0 * float(np.median(steps)), 1e-6)
+        self.cell_size = float(cell_size)
+        self.origin = lo
+        self.grid = np.floor(extent / self.cell_size).astype(np.int64) + 1
+        n_cells = int(np.prod(self.grid))
+        if n_cells >= 2**31 or n_edges >= 2**31:
+            raise ValueError(
+                f"{n_edges} segments in {n_cells} cells is too large for this engine; "
+                "pass a larger cell_size"
+            )
+
+        # Each filing is one int64: cell << 32 | single-cell flag << 31 | segment.
+        # Sorting them in place orders the index by cell without the int64
+        # index array an argsort would allocate.
+        parts: list[npt.NDArray[np.int64]] = []
+        long: list[npt.NDArray] = []
+        for first in range(0, n_edges, _BUILD_BLOCK):
+            s = self._start[first:first + _BUILD_BLOCK]
+            e = self._end[first:first + _BUILD_BLOCK]
+            a = vertices[s].astype(np.float64)
+            b = vertices[e].astype(np.float64)
+            c_lo = self._cell(np.minimum(a, b))
+            c_hi = self._cell(np.maximum(a, b))
+            del a, b
+            span = c_hi - c_lo + 1
+            copies = span.prod(axis=1)
+            ids = np.arange(first, first + len(s), dtype=np.int64)
+            one = copies == 1
+            parts.append(self._linear(c_lo[one]) << 32 | np.int64(1) << 31 | ids[one])
+            many = (copies > 1) & (copies <= long_cells)
+            long.append(ids[copies > long_cells].astype(self._start.dtype))
+            if many.any():
+                # Repeat counts are intp: numpy refuses int64 ones where intp
+                # is 32-bit, as under Pyodide.
+                n = copies[many].astype(np.intp)
+                which = np.repeat(np.arange(len(n)), n)
+                k = np.arange(int(n.sum())) - np.repeat(np.cumsum(n) - n, n)
+                sy, sz = span[many][which, 1], span[many][which, 2]
+                cell = c_lo[many][which] + np.column_stack([k // (sy * sz), (k // sz) % sy, k % sz])
+                parts.append(self._linear(cell) << 32 | ids[many][which])
+        packed = np.concatenate(parts)
+        del parts
+        packed.sort()
+        self._long = np.concatenate(long)
+        self._cell_start = np.searchsorted(
+            packed, np.arange(n_cells + 1, dtype=np.int64) << 32,
+        ).astype(np.int64)
+        self._filed = np.empty(len(packed), dtype=self._start.dtype)
+        self._single = np.empty(len(packed), dtype=bool)
+        for first in range(0, len(packed), _BUILD_BLOCK):
+            block = packed[first:first + _BUILD_BLOCK]
+            self._filed[first:first + _BUILD_BLOCK] = block & 0x7FFFFFFF
+            self._single[first:first + _BUILD_BLOCK] = (block >> 31) & 1
+        del packed
+
+    def _cell(self, points: npt.NDArray[np.float64]) -> npt.NDArray[np.int64]:
+        cell = np.floor((points - self.origin) / self.cell_size).astype(np.int64)
+        return np.clip(cell, 0, self.grid - 1)
+
+    def _linear(self, cell: npt.NDArray[np.int64]) -> npt.NDArray[np.int64]:
+        return (cell[:, 0] * self.grid[1] + cell[:, 1]) * self.grid[2] + cell[:, 2]
+
+    @property
+    def index_bytes(self) -> int:
+        """Bytes the index adds on top of the tractogram."""
+        return int(
+            self._filed.nbytes + self._single.nbytes + self._cell_start.nbytes
+            + self._long.nbytes + self._start.nbytes + self._end.nbytes + self._owner.nbytes
+            + self._first.nbytes + self._last.nbytes
+        )
+
+    def _cells(self, region) -> npt.NDArray[np.int64]:
+        """``(i, j, k)`` of every cell the region's bounding box touches."""
+        lo, hi = region_bounds(region)
+        # Widened by a hair, so a point the exact test accepts by rounding at
+        # the region's rim is never in a cell left out.
+        with np.errstate(invalid="ignore"):  # a slab's infinite sides stay infinite
+            lo = np.where(np.isfinite(lo), lo - 1e-9 * (1.0 + np.abs(lo)), lo)
+            hi = np.where(np.isfinite(hi), hi + 1e-9 * (1.0 + np.abs(hi)), hi)
+        world_hi = self.origin + self.grid * self.cell_size
+        if np.any(hi < self.origin) or np.any(lo > world_hi) or np.any(hi < lo):
+            return np.zeros((0, 3), dtype=np.int64)
+        c_lo = self._cell(np.maximum(lo, self.origin)[None])[0]
+        c_hi = self._cell(np.minimum(hi, world_hi)[None])[0]
+        axes = [np.arange(c_lo[i], c_hi[i] + 1) for i in range(3)]
+        return np.stack(np.meshgrid(*axes, indexing="ij"), -1).reshape(-1, 3)
+
+    def _inside(self, region, cells: npt.NDArray[np.int64]) -> npt.NDArray[np.bool_]:
+        """Which cells lie wholly inside the region (always False for a disk or mask).
+
+        A segment filed under one cell only lies in that cell, so in such a
+        cell it meets the region without being tested.  The cells are
+        widened by a hair, so rounding can only make a cell count as not
+        inside.
+        """
+        if len(cells) == 0 or not isinstance(region, (Sphere, Box, Slab)):
+            return np.zeros(len(cells), dtype=bool)
+        lo = self.origin + cells * self.cell_size
+        hi = lo + self.cell_size
+        lo = lo - 1e-9 * (1.0 + np.abs(lo) + self.cell_size)
+        hi = hi + 1e-9 * (1.0 + np.abs(hi) + self.cell_size)
+        if isinstance(region, Sphere):
+            c = np.asarray(region.center)
+            far = np.maximum(np.abs(lo - c), np.abs(hi - c))
+            return np.einsum("ij,ij->i", far, far) <= region.radius ** 2
+        if isinstance(region, Box):
+            return np.all(lo >= np.asarray(region.min), axis=1) & np.all(
+                hi <= np.asarray(region.max), axis=1)
+        return (lo[:, region.axis] >= region.min) & (hi[:, region.axis] <= region.max)
+
+    def _positions(self, cells: npt.NDArray[np.int64]) -> npt.NDArray[np.intp]:
+        """Positions in the filing of every segment filed under ``cells``."""
+        linear = self._linear(cells)
+        begin = self._cell_start[linear]
+        counts = (self._cell_start[linear + 1] - begin).astype(np.intp)
+        total = int(counts.sum())
+        k = np.arange(total, dtype=np.intp) - np.repeat(np.cumsum(counts) - counts, counts)
+        return np.repeat(begin, counts).astype(np.intp) + k
+
+    def _passes_path(self, region) -> npt.NDArray[np.bool_]:
+        out = np.zeros(self.tractogram.n_objects, dtype=bool)
+        cells = self._cells(region)
+        inside = self._inside(region, cells)
+        pos = self._positions(cells[inside])
+        single = self._single[pos]
+        sure = self._filed[pos[single]]
+        out[self._owner[sure]] = True
+        pos = np.concatenate([pos[~single], self._positions(cells[~inside])])
+        test = np.concatenate([self._filed[pos], self._long])
+        tested = 0
+        vertices = self.tractogram.vertices
+        for first in range(0, len(test), _QUERY_BLOCK):
+            # Skip segments of streamlines already accepted.
+            chunk = test[first:first + _QUERY_BLOCK]
+            chunk = chunk[~out[self._owner[chunk]]]
+            tested += len(chunk)
+            a = vertices[self._start[chunk]].astype(np.float64)
+            b = vertices[self._end[chunk]].astype(np.float64)
+            out[self._owner[chunk[segment_hits(a, b, region)]]] = True
+        self.last_query = {
+            "cells": int(len(cells)), "inside_cells": int(inside.sum()),
+            "accepted_untested": int(len(sure)), "candidates": int(len(test)),
+            "tested": int(tested),
+        }
+        return out
+
+    # -- leaves ----------------------------------------------------------------
+
+    def leaf(self, node: Node) -> npt.NDArray[np.bool_]:
+        """A leaf's answer, from the cache when the same leaf was asked before."""
+        key = node.key()
+        hit = self._cache.get(key)
+        if hit is not None:
+            self._cache.move_to_end(key)
+            return hit
+        result = self._compute(node)
+        result.setflags(write=False)
+        self._cache[key] = result
+        while len(self._cache) > self._cache_size:
+            self._cache.popitem(last=False)
+        return result
+
+    def _compute(self, node: Node) -> npt.NDArray[np.bool_]:
+        n = self.tractogram.n_objects
+        if isinstance(node, Passes):
+            if node.mode != "path":
+                has = self._has
+                at_first = contains(self._first[has], node.region)
+                at_last = contains(self._last[has], node.region)
+                out = np.zeros(n, dtype=bool)
+                out[has] = at_first | at_last if node.mode == "endpoints" else at_first & at_last
+                return out
+            return self._passes_path(node.region)
+        if isinstance(node, Column):
+            return oracle.column_mask(node, self.tractogram)
+        if isinstance(node, InGroup):
+            return self.tractogram.group_mask(node.ids)
+        raise TypeError(f"{type(node).__name__} is not a leaf")
+
+    # -- trees -----------------------------------------------------------------
+
+    def evaluate(self, tree: Node) -> npt.NDArray[np.bool_]:
+        """Which streamlines the filter accepts: an ``(N,)`` bool array by row."""
+        if isinstance(tree, All):
+            return np.ones(self.tractogram.n_objects, dtype=bool)
+        if isinstance(tree, And):
+            out = self.evaluate(tree.children[0]).copy()
+            for child in tree.children[1:]:
+                out &= self.evaluate(child)
+            return out
+        if isinstance(tree, Or):
+            out = self.evaluate(tree.children[0]).copy()
+            for child in tree.children[1:]:
+                out |= self.evaluate(child)
+            return out
+        if isinstance(tree, Not):
+            return ~self.evaluate(tree.child)
+        return self.leaf(tree)
+
+    def clear(self) -> None:
+        """Forget every cached leaf (after the tractogram changes)."""
+        self._cache.clear()
+
+    @staticmethod
+    def publish(groups: Sequence[npt.NDArray[np.bool_]]) -> npt.NDArray[np.uint8]:
+        """One byte per row for the viewer: 0 hidden, else 1 + the first group showing it.
+
+        Groups are in draw order; at most 255 fit a byte.
+        """
+        if len(groups) > 255:
+            raise ValueError(f"at most 255 groups fit a byte mask, got {len(groups)}")
+        if not groups:
+            return np.zeros(0, dtype=np.uint8)
+        out = np.zeros(len(groups[0]), dtype=np.uint8)
+        for index in range(len(groups) - 1, -1, -1):
+            out[groups[index]] = index + 1
+        return out
diff --git a/zarr_vectors_tools/filtering/oracle.py b/zarr_vectors_tools/filtering/oracle.py
new file mode 100644
index 0000000..2005a55
--- /dev/null
+++ b/zarr_vectors_tools/filtering/oracle.py
@@ -0,0 +1,132 @@
+"""The brute-force reference: every predicate, tested on every segment.
+
+This is the ground truth the faster engines are measured against -- the
+indexed numpy engine here, and the browser engines built later.  It keeps
+nothing between calls and prunes nothing: a region leaf runs the exact
+segment test of :mod:`~zarr_vectors_tools.filtering.geometry` over all of
+the tractogram's segments, a batch at a time.  Slow on purpose, and simple
+enough to check by reading.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import Any
+
+import numpy as np
+import numpy.typing as npt
+
+from .geometry import contains, segment_hits
+from .predicates import All, And, Column, InGroup, Node, Not, Or, Passes
+from .tractogram import Tractogram
+
+__all__ = ["column_mask", "evaluate", "histogram", "passes", "summarize"]
+
+#: Segments tested per batch.
+_BLOCK = 1 << 20
+
+
+def evaluate(tree: Node, tractogram: Tractogram) -> npt.NDArray[np.bool_]:
+    """Which streamlines the filter accepts: an ``(N,)`` bool array by row."""
+    if isinstance(tree, All):
+        return np.ones(tractogram.n_objects, dtype=bool)
+    if isinstance(tree, Passes):
+        return passes(tree, tractogram)
+    if isinstance(tree, Column):
+        return column_mask(tree, tractogram)
+    if isinstance(tree, InGroup):
+        return tractogram.group_mask(tree.ids)
+    if isinstance(tree, And):
+        return np.logical_and.reduce([evaluate(c, tractogram) for c in tree.children])
+    if isinstance(tree, Or):
+        return np.logical_or.reduce([evaluate(c, tractogram) for c in tree.children])
+    if isinstance(tree, Not):
+        return ~evaluate(tree.child, tractogram)
+    raise TypeError(f"cannot evaluate {type(tree).__name__}")
+
+
+def passes(leaf: Passes, tractogram: Tractogram) -> npt.NDArray[np.bool_]:
+    """Rows that meet the leaf's region, by path or by their ends."""
+    out = np.zeros(tractogram.n_objects, dtype=bool)
+    if leaf.mode == "path":
+        start, end, owner = tractogram.edges()
+        vertices = tractogram.vertices
+        for lo in range(0, len(start), _BLOCK):
+            a = vertices[start[lo:lo + _BLOCK]].astype(np.float64)
+            b = vertices[end[lo:lo + _BLOCK]].astype(np.float64)
+            hit = segment_hits(a, b, leaf.region)
+            out[owner[lo:lo + _BLOCK][hit]] = True
+        return out
+    first, last, has = tractogram.endpoints()
+    at_first = contains(first[has], leaf.region)
+    at_last = contains(last[has], leaf.region)
+    out[has] = at_first | at_last if leaf.mode == "endpoints" else at_first & at_last
+    return out
+
+
+def column_mask(leaf: Column, tractogram: Tractogram) -> npt.NDArray[np.bool_]:
+    """Rows whose column value passes the comparison (absent values never do)."""
+    values, present = tractogram.column(leaf.name, leaf.channel)
+    if leaf.cmp == "absent":
+        return ~present
+    with np.errstate(invalid="ignore"):
+        if leaf.cmp == "<":
+            hit = values < leaf.value
+        elif leaf.cmp == "<=":
+            hit = values <= leaf.value
+        elif leaf.cmp == ">":
+            hit = values > leaf.value
+        elif leaf.cmp == ">=":
+            hit = values >= leaf.value
+        elif leaf.cmp == "==":
+            hit = values == leaf.value
+        elif leaf.cmp == "!=":
+            hit = values != leaf.value
+        elif leaf.cmp == "between":
+            hit = (values >= leaf.value[0]) & (values <= leaf.value[1])
+        else:  # "in"
+            hit = np.isin(values, np.asarray(leaf.value))
+    return np.asarray(hit, dtype=bool) & present
+
+
+def summarize(
+    accepted: npt.NDArray[np.bool_],
+    tractogram: Tractogram,
+    columns: Sequence[str] = ("length",),
+) -> dict[str, Any]:
+    """Count of accepted rows and, per column, statistics over them.
+
+    Each column reports ``n`` (accepted rows with a value), ``mean``,
+    ``std`` (population, ddof 0), ``min`` and ``max``; NaN where ``n`` is 0.
+    Multi-channel columns are summarised per channel as ``name[c]``.
+    """
+    accepted = np.asarray(accepted, dtype=bool)
+    out: dict[str, Any] = {"count": int(accepted.sum())}
+    for name in columns:
+        width = tractogram.columns[name].shape[1] if tractogram.columns[name].ndim == 2 else None
+        for channel in [None] if width is None else range(width):
+            values, present = tractogram.column(name, channel)
+            chosen = values[accepted & present].astype(np.float64)
+            label = name if channel is None else f"{name}[{channel}]"
+            if len(chosen) == 0:
+                out[label] = {"n": 0, "mean": np.nan, "std": np.nan, "min": np.nan, "max": np.nan}
+            else:
+                out[label] = {
+                    "n": int(len(chosen)), "mean": float(chosen.mean()),
+                    "std": float(chosen.std()), "min": float(chosen.min()),
+                    "max": float(chosen.max()),
+                }
+    return out
+
+
+def histogram(
+    accepted: npt.NDArray[np.bool_],
+    tractogram: Tractogram,
+    column: str,
+    bins: npt.ArrayLike,
+    channel: int | None = None,
+) -> npt.NDArray[np.int64]:
+    """Counts of accepted rows' values in ``bins`` (edges, as numpy.histogram)."""
+    values, present = tractogram.column(column, channel)
+    counts, _ = np.histogram(values[np.asarray(accepted, bool) & present], bins=np.asarray(bins))
+    return counts
diff --git a/zarr_vectors_tools/filtering/predicates.py b/zarr_vectors_tools/filtering/predicates.py
new file mode 100644
index 0000000..e045451
--- /dev/null
+++ b/zarr_vectors_tools/filtering/predicates.py
@@ -0,0 +1,563 @@
+"""Filter trees for streamlines: regions, leaves, operators, and their JSON.
+
+A TrackVis-style filter is a tree.  Each leaf asks one question of every
+streamline and answers yes or no:
+
+- :class:`Passes` -- does the streamline meet a region (:class:`Sphere`,
+  :class:`Box`, :class:`Slab`, :class:`Disk` or :class:`Mask`)?  ``mode``
+  says which part of it counts: ``"path"`` (any segment), ``"endpoints"``
+  (either end) or ``"both_endpoints"``.
+- :class:`Column` -- does a per-streamline value pass a comparison?
+- :class:`InGroup` -- is the streamline a member of any of these groups?
+- :class:`All` -- yes, always (the default group before any filter).
+
+:class:`And`, :class:`Or` and :class:`Not` combine them, and so do the
+operators ``&``, ``|``, ``~`` and ``-`` (and-not) on any node.
+
+The JSON form (:func:`to_json` / :func:`from_json`) is the contract between
+engines: the brute-force oracle here, the indexed numpy engine, and the
+browser engines that are tested against them all read the same document.
+Coordinates are world millimetres, the same space
+:func:`~zarr_vectors_tools.algorithms.select_streamlines` takes regions in.
+
+What each region means, exactly
+-------------------------------
+Every set is closed, so a segment that just touches a region meets it.
+
+- ``sphere``: some point of the segment is within ``radius`` of ``center``.
+- ``box``: the segment meets the axis-aligned box ``min``..``max``.
+- ``slab``: the segment's coordinate on ``axis`` takes some value in
+  ``min``..``max`` (a box unbounded on the other two axes; TrackVis's slice
+  filter).
+- ``disk``: the segment crosses the disk's plane at a point within
+  ``radius`` of ``center``, and the angle between the segment and the
+  disk's normal axis lies within ``angle`` (degrees, 0..90; direction does
+  not matter).  A segment lying in the plane does not cross it.
+- ``mask``: a point sampled along the segment falls in a nonzero voxel.  The
+  points are the segment's two vertices and ``ceil(length / spacing) - 1``
+  evenly spaced between them; a point is in the voxel its coordinates round
+  to.  ``spacing`` defaults to half the smallest voxel edge.  This is the
+  scheme :func:`~zarr_vectors_tools.algorithms.select_streamlines` uses, so
+  the two agree point for point.
+
+A streamline with one vertex is that point; one with none meets nothing.
+The endpoint modes test the first and last vertex as points, so they do not
+apply to a disk, which has no interior.
+
+Column comparisons
+------------------
+``cmp`` is one of ``<  <=  >  >=  ==  !=``, ``between`` (``value`` is
+``[lo, hi]``, inclusive), ``in`` (``value`` is a list) or ``absent``.  An
+absent value -- a row the store marks absent, or a NaN -- passes no
+comparison, ``!=`` included, and passes only ``absent``.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import math
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from typing import Any
+
+import numpy as np
+import numpy.typing as npt
+
+__all__ = [
+    "All",
+    "And",
+    "Box",
+    "COMPARISONS",
+    "Column",
+    "Disk",
+    "FORMAT",
+    "InGroup",
+    "MODES",
+    "Mask",
+    "Node",
+    "Not",
+    "Or",
+    "Passes",
+    "Region",
+    "Slab",
+    "Sphere",
+    "VERSION",
+    "from_json",
+    "to_json",
+]
+
+#: Name and version written into every JSON document.  A reader refuses a
+#: version it does not know.
+FORMAT = "zvf-predicate"
+VERSION = 1
+
+MODES = ("path", "endpoints", "both_endpoints")
+COMPARISONS = ("<", "<=", ">", ">=", "==", "!=", "between", "in", "absent")
+
+
+def _vec3(values: Iterable[float], what: str) -> tuple[float, float, float]:
+    out = tuple(float(v) for v in values)
+    if len(out) != 3 or not all(math.isfinite(v) for v in out):
+        raise ValueError(f"{what} must be three finite numbers, got {list(out)}")
+    return out  # type: ignore[return-value]
+
+
+def _finite(value: float, what: str) -> float:
+    out = float(value)
+    if not math.isfinite(out):
+        raise ValueError(f"{what} must be finite, got {value}")
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Regions
+# ---------------------------------------------------------------------------
+
+
+class Region:
+    """Base class of the shapes a :class:`Passes` leaf tests against."""
+
+    kind: str = ""
+
+    def to_json(self) -> dict[str, Any]:  # pragma: no cover - every subclass overrides
+        raise NotImplementedError
+
+
+@dataclass(frozen=True)
+class Sphere(Region):
+    """A ball: ``center`` and ``radius`` in world millimetres."""
+
+    center: tuple[float, float, float]
+    radius: float
+    kind = "sphere"
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "center", _vec3(self.center, "sphere center"))
+        radius = _finite(self.radius, "sphere radius")
+        if radius < 0:
+            raise ValueError(f"sphere radius must be 0 or more, got {radius}")
+        object.__setattr__(self, "radius", radius)
+
+    def to_json(self) -> dict[str, Any]:
+        return {"type": self.kind, "center": list(self.center), "radius": self.radius}
+
+
+@dataclass(frozen=True)
+class Box(Region):
+    """An axis-aligned box from corner ``min`` to corner ``max``."""
+
+    min: tuple[float, float, float]
+    max: tuple[float, float, float]
+    kind = "box"
+
+    def __post_init__(self) -> None:
+        lo, hi = _vec3(self.min, "box min"), _vec3(self.max, "box max")
+        if any(h < low for low, h in zip(lo, hi)):
+            raise ValueError(f"box max corner {list(hi)} is below its min corner {list(lo)}")
+        object.__setattr__(self, "min", lo)
+        object.__setattr__(self, "max", hi)
+
+    def to_json(self) -> dict[str, Any]:
+        return {"type": self.kind, "min": list(self.min), "max": list(self.max)}
+
+
+@dataclass(frozen=True)
+class Slab(Region):
+    """Everything whose coordinate on ``axis`` (0, 1 or 2) is in ``min``..``max``."""
+
+    axis: int
+    min: float
+    max: float
+    kind = "slab"
+
+    def __post_init__(self) -> None:
+        if self.axis not in (0, 1, 2):
+            raise ValueError(f"slab axis must be 0, 1 or 2, got {self.axis}")
+        lo, hi = _finite(self.min, "slab min"), _finite(self.max, "slab max")
+        if hi < lo:
+            raise ValueError(f"slab max {hi} is below its min {lo}")
+        object.__setattr__(self, "axis", int(self.axis))
+        object.__setattr__(self, "min", lo)
+        object.__setattr__(self, "max", hi)
+
+    def to_json(self) -> dict[str, Any]:
+        return {"type": self.kind, "axis": self.axis, "min": self.min, "max": self.max}
+
+
+@dataclass(frozen=True)
+class Disk(Region):
+    """A flat disk, crossed by segments whose angle to ``normal`` is in ``angle``.
+
+    ``normal`` is normalised on construction.  ``angle`` is ``(lo, hi)`` in
+    degrees between the segment and the normal axis: ``(0, 90)`` accepts any
+    crossing, ``(0, 30)`` only segments within 30 degrees of the normal.
+    """
+
+    center: tuple[float, float, float]
+    normal: tuple[float, float, float]
+    radius: float
+    angle: tuple[float, float] = (0.0, 90.0)
+    kind = "disk"
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "center", _vec3(self.center, "disk center"))
+        normal = np.asarray(_vec3(self.normal, "disk normal"))
+        norm = float(np.linalg.norm(normal))
+        if norm == 0:
+            raise ValueError("disk normal must not be the zero vector")
+        object.__setattr__(self, "normal", tuple(float(v) for v in normal / norm))
+        radius = _finite(self.radius, "disk radius")
+        if radius < 0:
+            raise ValueError(f"disk radius must be 0 or more, got {radius}")
+        object.__setattr__(self, "radius", radius)
+        lo, hi = (_finite(a, "disk angle") for a in self.angle)
+        if not 0 <= lo <= hi <= 90:
+            raise ValueError(f"disk angle must satisfy 0 <= lo <= hi <= 90, got {[lo, hi]}")
+        object.__setattr__(self, "angle", (lo, hi))
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "type": self.kind, "center": list(self.center), "normal": list(self.normal),
+            "radius": self.radius, "angle": list(self.angle),
+        }
+
+
+@dataclass(frozen=True, eq=False)
+class Mask(Region):
+    """A voxel region: nonzero ``voxels`` placed in the world by ``affine``.
+
+    ``affine`` maps voxel indices to world millimetres (a NIfTI affine).
+    Two masks are equal when their voxels, affine and spacing are.
+    """
+
+    voxels: npt.NDArray[np.bool_]
+    affine: npt.NDArray[np.float64]
+    spacing: float | None = None
+    _to_voxel: npt.NDArray[np.float64] = field(init=False, repr=False)
+    kind = "mask"
+
+    def __post_init__(self) -> None:
+        voxels = np.asarray(self.voxels)
+        if voxels.ndim == 4 and voxels.shape[3] == 1:
+            voxels = voxels[..., 0]
+        if voxels.ndim != 3:
+            raise ValueError(f"a mask must be 3-D, got shape {voxels.shape}")
+        voxels = np.ascontiguousarray(voxels != 0)
+        voxels.setflags(write=False)
+        affine = np.asarray(self.affine, dtype=np.float64).reshape(4, 4).copy()
+        affine.setflags(write=False)
+        object.__setattr__(self, "voxels", voxels)
+        object.__setattr__(self, "affine", affine)
+        object.__setattr__(self, "_to_voxel", np.linalg.inv(affine))
+        if self.spacing is not None:
+            spacing = _finite(self.spacing, "mask spacing")
+            if spacing <= 0:
+                raise ValueError(f"mask spacing must be above 0, got {spacing}")
+            object.__setattr__(self, "spacing", spacing)
+
+    @property
+    def sample_spacing(self) -> float:
+        """Distance between points tested along a segment."""
+        if self.spacing is not None:
+            return self.spacing
+        return float(np.linalg.norm(self.affine[:3, :3], axis=0).min()) / 2.0
+
+    def contains(self, points: npt.NDArray) -> npt.NDArray[np.bool_]:
+        """Whether each world point falls in a nonzero voxel."""
+        to_voxel = self._to_voxel
+        ijk = np.rint(points @ to_voxel[:3, :3].T + to_voxel[:3, 3]).astype(np.int64)
+        shape = np.asarray(self.voxels.shape)
+        valid = np.all((ijk >= 0) & (ijk < shape), axis=1)
+        hit = np.zeros(len(points), dtype=bool)
+        hit[valid] = self.voxels[tuple(ijk[valid].T)]
+        return hit
+
+    def world_bounds(self) -> tuple[npt.NDArray[np.float64], npt.NDArray[np.float64]]:
+        """World box around every nonzero voxel (each voxel +/- half a voxel)."""
+        occupied = np.argwhere(self.voxels)
+        if len(occupied) == 0:
+            return np.full(3, np.inf), np.full(3, -np.inf)
+        corners = np.array(np.meshgrid(*[
+            [occupied[:, a].min() - 0.5, occupied[:, a].max() + 0.5] for a in range(3)
+        ], indexing="ij")).reshape(3, -1).T
+        world = corners @ self.affine[:3, :3].T + self.affine[:3, 3]
+        return world.min(axis=0), world.max(axis=0)
+
+    def to_json(self) -> dict[str, Any]:
+        out: dict[str, Any] = {
+            "type": self.kind,
+            "shape": list(self.voxels.shape),
+            "affine": self.affine.tolist(),
+            # C order, most significant bit first (numpy.packbits).
+            "bits": base64.b64encode(np.packbits(self.voxels.ravel())).decode("ascii"),
+        }
+        if self.spacing is not None:
+            out["spacing"] = self.spacing
+        return out
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Mask):
+            return NotImplemented
+        return (
+            self.spacing == other.spacing
+            and self.voxels.shape == other.voxels.shape
+            and np.array_equal(self.affine, other.affine)
+            and np.array_equal(self.voxels, other.voxels)
+        )
+
+    def __hash__(self) -> int:
+        return hash(_digest(self.to_json()))
+
+
+def _region_from_json(doc: dict[str, Any]) -> Region:
+    kind = doc.get("type")
+    if kind == "sphere":
+        return Sphere(doc["center"], doc["radius"])
+    if kind == "box":
+        return Box(doc["min"], doc["max"])
+    if kind == "slab":
+        return Slab(int(doc["axis"]), doc["min"], doc["max"])
+    if kind == "disk":
+        return Disk(doc["center"], doc["normal"], doc["radius"], tuple(doc.get("angle", (0, 90))))
+    if kind == "mask":
+        shape = tuple(int(s) for s in doc["shape"])
+        bits = np.frombuffer(base64.b64decode(doc["bits"]), dtype=np.uint8)
+        voxels = np.unpackbits(bits, count=int(np.prod(shape))).astype(bool).reshape(shape)
+        return Mask(voxels, np.asarray(doc["affine"], dtype=np.float64), doc.get("spacing"))
+    raise ValueError(f"unknown region type {kind!r}")
+
+
+# ---------------------------------------------------------------------------
+# Tree nodes
+# ---------------------------------------------------------------------------
+
+
+class Node:
+    """Base class of every filter tree node."""
+
+    def __and__(self, other: Node) -> And:
+        return And(self, other)
+
+    def __or__(self, other: Node) -> Or:
+        return Or(self, other)
+
+    def __invert__(self) -> Not:
+        return Not(self)
+
+    def __sub__(self, other: Node) -> And:
+        return And(self, Not(other))
+
+    def to_json(self) -> dict[str, Any]:  # pragma: no cover - every subclass overrides
+        raise NotImplementedError
+
+    def key(self) -> str:
+        """A stable digest of the node, for caching its result."""
+        return _digest(self.to_json())
+
+    def leaves(self) -> list[Node]:
+        """The leaves under this node, left to right."""
+        return [self]
+
+
+@dataclass(frozen=True)
+class All(Node):
+    """Every streamline."""
+
+    def to_json(self) -> dict[str, Any]:
+        return {"op": "all"}
+
+
+@dataclass(frozen=True)
+class Passes(Node):
+    """Streamlines that meet ``region``, by path or by their ends."""
+
+    region: Region
+    mode: str = "path"
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.region, Region):
+            raise TypeError(f"Passes needs a region, got {type(self.region).__name__}")
+        if self.mode not in MODES:
+            raise ValueError(f"mode must be one of {', '.join(MODES)}; got {self.mode!r}")
+        if self.mode != "path" and isinstance(self.region, Disk):
+            raise ValueError("a disk has no inside, so it takes only mode='path'")
+
+    def to_json(self) -> dict[str, Any]:
+        return {"op": "passes", "mode": self.mode, "region": self.region.to_json()}
+
+
+@dataclass(frozen=True)
+class Column(Node):
+    """Streamlines whose ``name`` column passes ``cmp value``.
+
+    ``channel`` picks one channel of a multi-channel column.
+    """
+
+    name: str
+    cmp: str
+    value: Any = None
+    channel: int | None = None
+
+    def __post_init__(self) -> None:
+        if self.cmp not in COMPARISONS:
+            raise ValueError(f"cmp must be one of {', '.join(COMPARISONS)}; got {self.cmp!r}")
+        value = self.value
+        if self.cmp == "absent":
+            value = None
+        elif self.cmp == "between":
+            lo, hi = (float(v) for v in value)
+            if hi < lo:
+                raise ValueError(f"between needs lo <= hi, got {[lo, hi]}")
+            value = (lo, hi)
+        elif self.cmp == "in":
+            value = tuple(sorted({_number(v) for v in value}))
+        else:
+            value = _number(value)
+        object.__setattr__(self, "value", value)
+
+    def to_json(self) -> dict[str, Any]:
+        out: dict[str, Any] = {"op": "column", "name": self.name, "cmp": self.cmp}
+        if self.value is not None:
+            out["value"] = list(self.value) if isinstance(self.value, tuple) else self.value
+        if self.channel is not None:
+            out["channel"] = int(self.channel)
+        return out
+
+
+def _number(value: Any) -> int | float:
+    if isinstance(value, (bool, np.bool_)):
+        return int(value)
+    if isinstance(value, (int, np.integer)):
+        return int(value)
+    return float(value)
+
+
+@dataclass(frozen=True)
+class InGroup(Node):
+    """Streamlines that belong to any of the groups ``ids``."""
+
+    ids: tuple[int, ...]
+
+    def __post_init__(self) -> None:
+        ids = tuple(sorted({int(i) for i in self.ids}))
+        if any(i < 0 for i in ids):
+            raise ValueError(f"group ids are 0 or more, got {list(ids)}")
+        object.__setattr__(self, "ids", ids)
+
+    def to_json(self) -> dict[str, Any]:
+        return {"op": "group", "ids": list(self.ids)}
+
+
+class _Combine(Node):
+    op = ""
+
+    def __init__(self, *children: Node) -> None:
+        if len(children) == 1 and not isinstance(children[0], Node):
+            children = tuple(children[0])
+        if not children:
+            raise ValueError(f"{self.op} needs at least one operand")
+        for child in children:
+            if not isinstance(child, Node):
+                raise TypeError(f"{self.op} operands are nodes, got {type(child).__name__}")
+        self.children: tuple[Node, ...] = tuple(children)
+
+    def __eq__(self, other: object) -> bool:
+        return type(self) is type(other) and self.children == other.children  # type: ignore[attr-defined]
+
+    def __hash__(self) -> int:
+        return hash((self.op, self.children))
+
+    def __repr__(self) -> str:
+        return f"{type(self).__name__}({', '.join(map(repr, self.children))})"
+
+    def to_json(self) -> dict[str, Any]:
+        return {"op": self.op, "args": [c.to_json() for c in self.children]}
+
+    def leaves(self) -> list[Node]:
+        return [leaf for child in self.children for leaf in child.leaves()]
+
+
+class And(_Combine):
+    """Streamlines every operand accepts."""
+
+    op = "and"
+
+
+class Or(_Combine):
+    """Streamlines any operand accepts."""
+
+    op = "or"
+
+
+class Not(Node):
+    """Streamlines the operand rejects."""
+
+    def __init__(self, child: Node) -> None:
+        if not isinstance(child, Node):
+            raise TypeError(f"not takes a node, got {type(child).__name__}")
+        self.child = child
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, Not) and self.child == other.child
+
+    def __hash__(self) -> int:
+        return hash(("not", self.child))
+
+    def __repr__(self) -> str:
+        return f"Not({self.child!r})"
+
+    def to_json(self) -> dict[str, Any]:
+        return {"op": "not", "arg": self.child.to_json()}
+
+    def leaves(self) -> list[Node]:
+        return self.child.leaves()
+
+
+def _node_from_json(doc: dict[str, Any]) -> Node:
+    op = doc.get("op")
+    if op == "all":
+        return All()
+    if op == "passes":
+        return Passes(_region_from_json(doc["region"]), doc.get("mode", "path"))
+    if op == "column":
+        return Column(doc["name"], doc["cmp"], doc.get("value"), doc.get("channel"))
+    if op == "group":
+        return InGroup(tuple(doc["ids"]))
+    if op == "and":
+        return And(*[_node_from_json(d) for d in doc["args"]])
+    if op == "or":
+        return Or(*[_node_from_json(d) for d in doc["args"]])
+    if op == "not":
+        return Not(_node_from_json(doc["arg"]))
+    raise ValueError(f"unknown node op {op!r}")
+
+
+def to_json(tree: Node) -> dict[str, Any]:
+    """The JSON document for ``tree``: ``{"format", "version", "tree"}``."""
+    return {"format": FORMAT, "version": VERSION, "tree": tree.to_json()}
+
+
+def from_json(doc: dict[str, Any] | str | bytes) -> Node:
+    """The tree a :func:`to_json` document (or its text) describes.
+
+    Raises:
+        ValueError: If the document is not a filter tree, is a version this
+            reader does not know, or names an unknown node or region.
+    """
+    if isinstance(doc, (str, bytes)):
+        doc = json.loads(doc)
+    if not isinstance(doc, dict) or doc.get("format") != FORMAT:
+        raise ValueError(f"not a {FORMAT} document")
+    if doc.get("version") != VERSION:
+        raise ValueError(
+            f"{FORMAT} version {doc.get('version')!r} is not supported (expected {VERSION})"
+        )
+    return _node_from_json(doc["tree"])
+
+
+def _digest(doc: dict[str, Any]) -> str:
+    text = json.dumps(doc, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha1(text.encode("utf-8")).hexdigest()
+
