{
  "name": "ngplatform",
  "version": "0.2.0",
  "private": true,
  "description": "A research workspace around Neuroglancer: datasets, scenes and plugins around a viewer that shows only data.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "budget": "node tests/e2e/bundle_budget.mjs",
    "preview": "vite preview",
    "test": "vitest --run && vitest --run --root plugins/zarr-vectors",
    "e2e": "node tests/e2e/smoke.mjs",
    "ui:audit": "node tests/e2e/ui_audit.mjs",
    "typecheck": "tsc -p . && tsc -p plugins/zarr-vectors",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "check:neuroglancer": "node scripts/neuroglancer_pin.mjs",
    "casts": "node scripts/neuroglancer_casts.mjs"
  },
  "dependencies": {
    "geotiff": "3.1.0-beta.0",
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2",
    "laz-perf": "0.0.7",
    "neuroglancer": "file:../neuroglancer",
    "neuroglancer-zarr-vectors": "file:plugins/zarr-vectors",
    "zarrita": "0.7.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.5",
    "@vitest/web-worker": "3.2.7",
    "eslint": "9.39.1",
    "jsdom": "27.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "neuroglancer": {
    "//": "The Neuroglancer commit the app is built against (file:../neuroglancer): scripts/neuroglancer_pin.mjs checks the sibling checkout against it; CI's FORK_SHA names the same commit.",
    "commit": "435cdcb012eceb70eb1e5200bdd919af3eb7a5c5"
  }
}
